# ─── Credenciales (nunca al repositorio) ───
.env
.env.local

# ─── Archivos subidos desde la app (foto del edificio) ───
# Misma razón que los iconos: identifican la propiedad real. Se conserva la
# estructura del directorio y su .htaccess, no el contenido.
uploads/**
!uploads/.htaccess
!uploads/edificio/
!uploads/edificio/.gitkeep

# ─── Iconos: son fotos del edificio real, identifican la ubicación ───
# Quedan en tu copia local, pero no se publican. Ver README.
apple-touch-icon.png
favicon.ico
favicon.svg
favicon-96x96.png
web-app-manifest-192x192.png
web-app-manifest-512x512.png

# ─── Volcados de la base: contienen datos personales de los propietarios ───
# Ningún .sql se publica. El esquema ya no vive en un dump: lo construye
# includes/migraciones.php, que sí está versionado.
*.sql
*.sql.gz

# ─── Logs y temporales ───
*.log
*.tmp
*.bak
*~

# ─── Sistema operativo / editores ───
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
