# ═══════════════════════════════════════════════
#  Plantilla de configuración
#  Copiá este archivo como ".env" y completá tus valores reales.
#  El .env nunca se sube al repositorio.
# ═══════════════════════════════════════════════

# ─── Base de datos MySQL ───
DB_HOST=localhost
DB_USER=edificio
DB_PASS="tu_password_mysql"
DB_NAME=edificio

# ─── Gmail / SMTP para envío de expensas ───
# MAIL_PASS es la "contraseña de aplicación" de 16 caracteres que genera
# Google (no la contraseña de la cuenta). Ver manual.md, sección 2.6.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_cuenta@gmail.com
MAIL_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM=tu_cuenta@gmail.com
MAIL_FROM_NAME="Administración del Edificio"
