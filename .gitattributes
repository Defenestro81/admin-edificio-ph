# Normaliza los finales de línea: se guardan como LF en el repositorio y se
# convierten a CRLF al trabajar en Windows. Evita diffs ruidosos donde todo
# un archivo aparece modificado por el salto de línea.
* text=auto

# Archivos binarios: que Git no les toque nada
*.png  binary
*.ico  binary
*.pdf  binary
*.zip  binary

# El .sql y el .svg son texto, pero conviene dejarlo explícito
*.sql  text
*.svg  text
